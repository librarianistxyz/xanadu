{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xanadu.local/schemas/xnd-bundle.schema.json",
  "title": "Xanadu (.xnd) Sync Bundle",
  "type": "object",
  "required": ["domains", "versions", "blobs"],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pubkey_hex"],
        "properties": {
          "name": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){0,62}\\.)+xnd$" },
          "pubkey_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "created_at": { "type": "number" }
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "version_num", "sha256", "signature_hex"],
        "properties": {
          "domain": { "type": "string" },
          "version_num": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "prev_sha256": { "type": "string", "pattern": "^(?:[0-9a-f]{64})?$" },
          "title": { "type": "string" },
          "kind": { "type": "string", "enum": ["document", "capsule"] },
          "pubkey_hex": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{64})?$" },
          "signature_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" },
          "created_at": { "type": "number" }
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256", "content"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content": { "type": "string" }
        }
      }
    },
    "assets": { "type": "array" },
    "links": { "type": "array" }
  }
}
